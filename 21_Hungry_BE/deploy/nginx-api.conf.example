server {
    listen 443 ssl;
    server_name api.gaebalmani.shop;

    ssl_certificate /etc/letsencrypt/live/api.gaebalmani.shop/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.gaebalmani.shop/privkey.pem;

    client_max_body_size 120m;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    location = /actuator/health/liveness { proxy_pass http://127.0.0.1:8080; }
    location = /actuator/health/readiness { proxy_pass http://127.0.0.1:8080; }
    location / { return 404; }
}
