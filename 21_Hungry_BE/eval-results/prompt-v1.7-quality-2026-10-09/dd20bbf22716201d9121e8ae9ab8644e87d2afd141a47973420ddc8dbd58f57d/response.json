      "logprobs" : [ ],
      "text" : "{\"schemaVersion\":\"1.8\",\"facts\":[{\"factId\":\"f1\",\"support\":{\"statementIds\":[\"sb31ffd444135v1u0006\",\"sb31ffd444135v1u0009\",\"sb31ffd444135v1u0010\",\"sb31ffd444135v1u0031\",\"sb31ffd444135v1u0049\",\"sb31ffd444135v1u0051\",\"sb31ffd444135v1u0056\",\"sb31ffd444135v1u0058\"],\"questionIds\":[],\"answerIds\":[], \"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"나흘 전부터 가슴, 손, 팔꿈치 안쪽에 피부가 매우 가렵고 아프며, 피부 일부가 갈라져 있습니다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f2\",\"support\":{\"statementIds\":[\"sb31ffd444135v1u0036\",\"sb31ffd444135v1u0040\",\"sb31ffd444135v1u0056\",\"sb31ffd444135v1u0058\",\"sb31ffd444135v1u0061\",\"sb31ffd444135v1u0063\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"피부에서 분비물이나 피/고름은 없고, 열, 기침, 호흡곤란은 없습니다. 소변은 잘 보는 편입니다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f3\",\"support\":{\"statementIds\":[\"sb31ffd444135v1u0014\",\"sb31ffd444135v1u0074\",\"sb31ffd444135v1u0068\",\"sb31ffd444135v1u0099\",\"sb31ffd444135v1u0101\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"과거 습진 병력이 있으며, 현재 증상은 습진이 다시 심해진 것일 가능성이 있습니다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[\"UNCERTAIN\"]},{\"factId\":\"f4\",\"support\":{\"statementIds\":[\"sb31ffd444135v1u0077\",\"sb31ffd444135v1u0079\",\"sb31ffd444135v1u0087\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"예전 천식은 현재는 없습니다. 정기 복용 약은 없고, 알레르기도 없습니다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f5\",\"support\":{\"statementIds\":[\"sb31ffd444135v1u0089\",\"sb31ffd444135v1u0091\",\"sb31ffd444135v1u0094\",\"sb31ffd444135v1u0097\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"환자는 룸메이트들과 함께 살며, 제약회사에서 일하고, 담배는 피우지 않으며, 술은 가끔 마십니다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f6\",\"support\":{\"statementIds\":[\"sb31ffd444135v1u0105\",\"sb31ffd444135v1u0108\",\"sb31ffd444135v1u0112\",\"sb31ffd444135v1u0113\",\"sb31ffd444135v1u0122\",\"sb31ffd444135v1u0124\",\"sb31ffd444135v1u0125\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"더 강한 스테로이드와 보습제를 처방하고, 목욕이나 샤워 후 바르는 보습제를 처음 7~10일 동안 규칙적으로 사용하며, 항히스타민제는 필요 시 시도할 수 있습니다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"PRESCRIBED\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":null,\"doseText\":null,\"frequencyText\":null,\"courseDurationText\":\"처음 7~10일\",\"instructions\":\"더 강한 스테로이드와 보습제를 처방함. 보습제는 목욕이나 샤워할 때/후에 바르는 것. 항히스타민제는 Loratadine, Piriton 또는 Fexofenadine 같은 것을 시도할 수 있음. 스테로이드와 보습제를 규칙적으로 사용하기.\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f7\",\"support\":{\"statementIds\":[\"sb31ffd444135v1u0104\",\"sb31ffd444135v1u0122\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"약국에서 산 스테로이드 크림보다 더 강한 스테로이드를 처방할 수 있습니다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"SUPERSEDED\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":null,\"doseText\":null,\"frequencyText\":null,\"courseDurationText\":null,\"instructions\":\"약국에서 산 스테로이드 크림을 대체/보완하는 더 강한 처방 스테로이드에 대한 설명.\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f8\",\"support\":{\"statementIds\":[\"sb31ffd444135v1u0115\",\"sb31ffd444135v1u0116\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"FOLLOW_UP\",\"text\":\"증상에 영향을 주는 계기(옷, 샤워 젤, 비누 등)를 일기로 남기고, 의심되는 유발 요인이 있으면 eczema CU에 대해 이야기해야 합니다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"FUTURE\",\"medication\":null,\"task\":{\"kind\":\"OTHER\",\"title\":\"유발 요인 기록\",\"date\":null,\"time\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[]},{\"factId\":\"f9\",\"support\":{\"statementIds\":[\"sb31ffd444135v1u0125\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"FOLLOW_UP\",\"text\":\"앞으로 1주에서 10일 동안 치료를 사용한 뒤 증상이 조절되지 않으면 다음 주에 다시 오세요.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"FUTURE\",\"medication\":null,\"task\":{\"kind\":\"OTHER\",\"title\":\"다음 주 재진\",\"date\":null,\"time\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[]}],\"summaryFactIds\":[\"f1\",\"f3\",\"f6\",\"f9\"]}"
