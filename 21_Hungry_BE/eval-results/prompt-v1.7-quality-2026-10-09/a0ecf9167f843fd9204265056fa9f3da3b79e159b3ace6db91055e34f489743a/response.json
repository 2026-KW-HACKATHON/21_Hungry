      "text" : "{\"schemaVersion\":\"1.8\",\"facts\":[{\"factId\":\"f1\",\"support\":{\"statementIds\":[\"s246c8d9f5bb8v1u0015\",\"s246c8d9f5bb8v1u0017\",\"s246c8d9f5bb8v1u0020\",\"s246c8d9f5bb8v1u0026\",\"s246c8d9f5bb8v1u0031\",\"s246c8d9f5bb8v1u0033\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"며칠째 기침과 콧물이 있고, 기침은 마른기침이며 거칠게 콜록거리는 양상이다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f2\",\"support\":{\"statementIds\":[\"s246c8d9f5bb8v1u0020\",\"s246c8d9f5bb8v1u0031\",\"s246c8d9f5bb8v1u0033\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"기침과 함께 근육통, 가끔 두통, 추위, 오한 같은 느낌이 있다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f3\",\"support\":{\"statementIds\":[\"s246c8d9f5bb8v1u0031\",\"s246c8d9f5bb8v1u0033\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"숨은 잘 쉬고, 숨참은 없다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f4\",\"support\":{\"statementIds\":[\"s246c8d9f5bb8v1u0025\",\"s246c8d9f5bb8v1u0026\",\"s246c8d9f5bb8v1u0029\",\"s246c8d9f5bb8v1u0033\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"기침할 때 가래는 없고, 피가 나오지 않는다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[\"CONFLICT\"]},{\"factId\":\"f5\",\"support\":{\"statementIds\":[\"s246c8d9f5bb8v1u0061\",\"s246c8d9f5bb8v1u0063\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"목 뒤가 약간 빨갛고 편도는 커져 있지 않으며, 목 주변에 만져지는 멍울은 없다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f6\",\"support\":{\"statementIds\":[\"s246c8d9f5bb8v1u0064\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"감기와 기침으로 보아 단순한 바이러스 감염 같다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f7\",\"support\":{\"statementIds\":[\"s246c8d9f5bb8v1u0066\",\"s246c8d9f5bb8v1u0073\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"Night Nurse, Day Nurse를 현재 약과 함께 써도 된다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"PRESCRIBED\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":\"Night Nurse, Day Nurse\",\"doseText\":null,\"frequencyText\":null,\"courseDurationText\":null,\"instructions\":\"현재 약과 함께 써도 된다.\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f8\",\"support\":{\"statementIds\":[\"s246c8d9f5bb8v1u0068\",\"s246c8d9f5bb8v1u0069\",\"s246c8d9f5bb8v1u0073\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"FOLLOW_UP\",\"text\":\"숨이 차거나 쌕쌕거림이 생기거나, 증상이 3주 넘게 지속되거나, 상태가 안 좋아지면 연락해야 한다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"FUTURE\",\"medication\":null,\"task\":{\"kind\":\"OTHER\",\"title\":\"연락\",\"date\":null,\"time\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[]},{\"factId\":\"f9\",\"support\":{\"statementIds\":[\"s246c8d9f5bb8v1u0075\"],\"questionIds\":[\"s246c8d9f5bb8v1u0074\"],\"answerIds\":[\"s246c8d9f5bb8v1u0075\"],\"correctionIds\":[]},\"kind\":\"FOLLOW_UP\",\"text\":\"현재는 처방전이 필요 없다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"CLINICIAN_ONLY\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f10\",\"support\":{\"statementIds\":[\"s246c8d9f5bb8v1u0041\",\"s246c8d9f5bb8v1u0045\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"metformin을 복용하며, 당뇨가 있고 5~6년 정도 되었다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"HISTORICAL\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":\"metformin\",\"doseText\":null,\"frequencyText\":null,\"courseDurationText\":null,\"instructions\":\"당뇨 때문에 복용한다.\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[\"UNCERTAIN_NAME\"]},{\"factId\":\"f11\",\"support\":{\"statementIds\":[\"s246c8d9f5bb8v1u0041\",\"s246c8d9f5bb8v1u0043\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"lisinopril을 복용하며, 혈압이 조금 높아서 먹는다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"HISTORICAL\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":\"lisinopril\",\"doseText\":null,\"frequencyText\":null,\"courseDurationText\":null,\"instructions\":\"혈압 때문에 복용한다.\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[\"UNCERTAIN_NAME\"]}],\"summaryFactIds\":[\"f6\",\"f7\",\"f8\"]}"
