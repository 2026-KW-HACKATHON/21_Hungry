      "annotations" : [ ],
      "logprobs" : [ ],
      "text" : "{\"schemaVersion\":\"1.0\",\"summary\":[{\"utteranceIds\":[\"sb31ffd444135v1u0099\",\"sb31ffd444135v1u0101\",\"sb31ffd444135v1u0071\",\"sb31ffd444135v1u0074\"],\"text\":\"습진이 다시 심해진 것으로 보이며, 가슴과 손, 팔꿈치 안쪽에 아주 가렵고 아픈 발진이 있음.\"},{\"utteranceIds\":[\"sb31ffd444135v1u0104\",\"sb31ffd444135v1u0105\",\"sb31ffd444135v1u0108\",\"sb31ffd444135v1u0112\",\"sb31ffd444135v1u0122\"],\"text\":\"더 강한 스테로이드 처방과 보습제를 시작하고, 가려움에는 항히스타민제를 추가로 사용할 수 있음.\"},{\"utteranceIds\":[\"sb31ffd444135v1u0125\"],\"text\":\"새 처방을 1주~10일 사용해 보고, 좋아지지 않으면 다음 주에 다시 오라고 함.\"}],\"details\":{\"symptoms\":[{\"utteranceIds\":[\"sb31ffd444135v1u0006\",\"sb31ffd444135v1u0009\",\"sb31ffd444135v1u0010\"],\"text\":\"나흘 전부터 피부가 아프고 빨갛고, 매우 가렵고 불편하며 잠과 일상에 지장이 있음.\"},{\"utteranceIds\":[\"sb31ffd444135v1u0027\",\"sb31ffd444135v1u0031\",\"sb31ffd444135v1u0051\",\"sb31ffd444135v1u0056\",\"sb31ffd444135v1u0058\"],\"text\":\"증상 부위는 가슴, 손, 팔꿈치 안쪽이고 얼굴에는 없으며, 열이나 다른 전신 증상은 없음.\"},{\"utteranceIds\":[\"sb31ffd444135v1u0033\",\"sb31ffd444135v1u0037\",\"sb31ffd444135v1u0040\"],\"text\":\"가려움과 함께 통증이 있고, 피부 일부가 갈라져 있으나 피나 고름은 보이지 않음.\"}],\"tests\":[{\"utteranceIds\":[\"sb31ffd444135v1u0070\",\"sb31ffd444135v1u0071\"],\"text\":\"진찰을 통해 발진을 직접 보고 어떤 발진인지 확인하려고 함.\"},{\"utteranceIds\":[\"sb31ffd444135v1u0102\"],\"text\":\"피부를 보니 발진이 꽤 익숙한 모습이라고 함.\"}],\"medicationMentions\":[{\"utteranceIds\":[\"sb31ffd444135v1u0104\",\"sb31ffd444135v1u0105\",\"sb31ffd444135v1u0108\",\"sb31ffd444135v1u0110\",\"sb31ffd444135v1u0124\",\"sb31ffd444135v1u0125\"],\"text\":\"더 강한 스테로이드를 오늘 처방하고, 보습제도 함께 처방함. 목욕이나 샤워할 때 쓰며 처음 7~10일 동안 사용하라고 했고, 스테로이드와 보습제를 규칙적으로 쓰는 것이 좋다고 함.\"},{\"utteranceIds\":[\"sb31ffd444135v1u0112\",\"sb31ffd444135v1u0113\",\"sb31ffd444135v1u0121\",\"sb31ffd444135v1u0122\"],\"text\":\"처방 없이 살 수 있는 항히스타민제로 Loratadine, Piriton, Fexofenadine을 언급했고, 가려움에 도움이 될 수 있다고 함.\"},{\"utteranceIds\":[\"sb31ffd444135v1u0117\",\"sb31ffd444135v1u0119\"],\"text\":\"최근 항히스타민제를 써 봤지만 별로 도움이 되지 않았다고 함.\"}],\"precautions\":[{\"utteranceIds\":[\"sb31ffd444135v1u0115\",\"sb31ffd444135v1u0116\"],\"text\":\"증상에 영향을 주는 계기로 옷, 샤워 젤, 비누 등을 일기로 남겨 보라고 함.\"},{\"utteranceIds\":[\"sb31ffd444135v1u0124\",\"sb31ffd444135v1u0125\"],\"text\":\"스테로이드와 보습제를 규칙적으로 사용하라고 함.\"}],\"followUps\":[{\"utteranceIds\":[\"sb31ffd444135v1u0125\"],\"text\":\"1주~10일 사용 후에도 좋아지지 않으면 다음 주에 다시 오라고 함.\"}]},\"items\":[{\"utteranceIds\":[\"sb31ffd444135v1u0104\",\"sb31ffd444135v1u0105\",\"sb31ffd444135v1u0108\",\"sb31ffd444135v1u0124\",\"sb31ffd444135v1u0125\"],\"itemKey\":\"med1\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"스테로이드 크림\",\"doseText\":null,\"frequencyText\":\"규칙적으로\",\"startsOn\":null,\"endsOn\":null,\"instructions\":\"보습제와 함께 사용. 목욕이나 샤워할 때 쓰며 처음 7~10일 동안 사용.\",\"supersedesMedicationId\":null,\"schedulePlans\":[{\"recurrence\":\"DAILY\",\"firstDate\":null,\"lastDate\":null,\"weekdays\":[],\"localTime\":null,\"durationMinutes\":10}]},\"uncertaintyCodes\":[],\"isConditional\":false},{\"utteranceIds\":[\"sb31ffd444135v1u0104\",\"sb31ffd444135v1u0105\",\"sb31ffd444135v1u0108\",\"sb31ffd444135v1u0124\",\"sb31ffd444135v1u0125\"],\"itemKey\":\"med2\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"보습제\",\"doseText\":null,\"frequencyText\":\"규칙적으로\",\"startsOn\":null,\"endsOn\":null,\"instructions\":\"스테로이드와 함께 사용. 목욕이나 샤워할 때 쓰며 처음 7~10일 동안 사용.\",\"supersedesMedicationId\":null,\"schedulePlans\":[{\"recurrence\":\"DAILY\",\"firstDate\":null,\"lastDate\":null,\"weekdays\":[],\"localTime\":null,\"durationMinutes\":10}]},\"uncertaintyCodes\":[],\"isConditional\":false},{\"utteranceIds\":[\"sb31ffd444135v1u0112\",\"sb31ffd444135v1u0113\",\"sb31ffd444135v1u0121\",\"sb31ffd444135v1u0122\"],\"itemKey\":\"med3\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"Loratadine\",\"doseText\":null,\"frequencyText\":\"필요 시 가려움 완화 목적\",\"startsOn\":null,\"endsOn\":null,\"instructions\":\"처방 없이 살 수 있는 항히스타민제로 언급됨.\",\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[],\"isConditional\":false},{\"utteranceIds\":[\"sb31ffd444135v1u0112\",\"sb31ffd444135v1u0113\",\"sb31ffd444135v1u0121\",\"sb31ffd444135v1u0122\"],\"itemKey\":\"med4\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"Piriton\",\"doseText\":null,\"frequencyText\":\"필요 시 가려움 완화 목적\",\"startsOn\":null,\"endsOn\":null,\"instructions\":\"처방 없이 살 수 있는 항히스타민제로 언급됨.\",\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[],\"isConditional\":false},{\"utteranceIds\":[\"sb31ffd444135v1u0112\",\"sb31ffd444135v1u0113\",\"sb31ffd444135v1u0121\",\"sb31ffd444135v1u0122\"],\"itemKey\":\"med5\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"Fexofenadine\",\"doseText\":null,\"frequencyText\":\"필요 시 가려움 완화 목적\",\"startsOn\":null,\"endsOn\":null,\"instructions\":\"오늘 드릴 수 있는 더 강한 항히스타민제로 언급됨.\",\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[],\"isConditional\":false}]}"
