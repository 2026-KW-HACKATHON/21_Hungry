      "text" : "{\"schemaVersion\":\"1.8\",\"facts\":[{\"factId\":\"f1\",\"support\":{\"statementIds\":[\"sc7d1c4933903v1u0004\",\"sc7d1c4933903v1u0005\",\"sc7d1c4933903v1u0007\",\"sc7d1c4933903v1u0010\",\"sc7d1c4933903v1u0011\",\"sc7d1c4933903v1u0019\",\"sc7d1c4933903v1u0021\",\"sc7d1c4933903v1u0023\",\"sc7d1c4933903v1u0041\",\"sc7d1c4933903v1u0042\",\"sc7d1c4933903v1u0039\",\"sc7d1c4933903v1u0048\",\"sc7d1c4933903v1u0052\",\"sc7d1c4933903v1u0054\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"정오부터 시작된 왼쪽 욱신거리는 심한 두통이 있고, 시야 흐림·지그재그 선이 보인 전조·메스꺼움·구토 2회·빛에 민감함이 동반됨\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f2\",\"support\":{\"statementIds\":[\"sc7d1c4933903v1u0021\",\"sc7d1c4933903v1u0023\",\"sc7d1c4933903v1u0132\",\"sc7d1c4933903v1u0133\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"움직이거나 앞으로 숙이거나 머리나 목을 움직이면 두통이 더 심해짐\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f3\",\"support\":{\"statementIds\":[\"sc7d1c4933903v1u0044\",\"sc7d1c4933903v1u0046\",\"sc7d1c4933903v1u0066\",\"sc7d1c4933903v1u0068\",\"sc7d1c4933903v1u0070\",\"sc7d1c4933903v1u0072\",\"sc7d1c4933903v1u0074\",\"sc7d1c4933903v1u0076\",\"sc7d1c4933903v1u0078\",\"sc7d1c4933903v1u0088\",\"sc7d1c4933903v1u0113\",\"sc7d1c4933903v1u0114\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"발열, 피부 발진, 말하기 문제, 팔다리 저림/힘빠짐, 균형 문제, 최근 머리 외상은 없다고 함\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f4\",\"support\":{\"statementIds\":[\"sc7d1c4933903v1u0080\",\"sc7d1c4933903v1u0085\",\"sc7d1c4933903v1u0088\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"환자는 본인에게 편두통 진단은 없지만 어머니에게 편두통이 있고, 어머니는 갑상선 기능 저하가 있으며 다른 뇌 관련 가족력은 없다고 함\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[\"CONFLICT\"]},{\"factId\":\"f5\",\"support\":{\"statementIds\":[\"sc7d1c4933903v1u0090\",\"sc7d1c4933903v1u0092\",\"sc7d1c4933903v1u0094\",\"sc7d1c4933903v1u0096\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"피임약 Microgynon을 피임 목적으로 3개월째 복용 중임\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"CONTINUE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":\"Microgynon\",\"doseText\":null,\"frequencyText\":null,\"courseDurationText\":\"3개월\",\"instructions\":\"피임용\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f6\",\"support\":{\"statementIds\":[\"sc7d1c4933903v1u0099\",\"sc7d1c4933903v1u0101\",\"sc7d1c4933903v1u0103\",\"sc7d1c4933903v1u0105\",\"sc7d1c4933903v1u0107\",\"sc7d1c4933903v1u0109\",\"sc7d1c4933903v1u0111\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"최근 직장 스트레스가 매우 심하지만 우울감은 없고, 스트레스 해소를 따로 하지 않으며 운동은 하지 않고 혼자 살면서 생활은 괜찮다고 함\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f7\",\"support\":{\"statementIds\":[\"sc7d1c4933903v1u0116\",\"sc7d1c4933903v1u0117\",\"sc7d1c4933903v1u0118\",\"sc7d1c4933903v1u0119\",\"sc7d1c4933903v1u0122\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"의사는 한 달 사이 두 번째 편두통으로 보이며, 한쪽 욱신거리는 두통·메스꺼움·구토·빛에 대한 민감성이 전형적이라 편두통성 두통일 수 있다고 설명함\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f8\",\"support\":{\"statementIds\":[\"sc7d1c4933903v1u0123\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"FOLLOW_UP\",\"text\":\"두통 유발 요인을 알기 위해 두통 일기를 쓰는 것이 중요함\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"FUTURE\",\"medication\":null,\"task\":{\"kind\":\"OTHER\",\"title\":\"두통 일기 쓰기\",\"date\":null,\"time\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[]},{\"factId\":\"f9\",\"support\":{\"statementIds\":[\"sc7d1c4933903v1u0124\",\"sc7d1c4933903v1u0125\",\"sc7d1c4933903v1u0126\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"오늘 두통에는 더 강한 진통제를 사용하며, Paracetamol 또는 Co-codamol, 또는 Ibuprofen 또는 Naproxen 같은 소염제를 고려함\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"ALTERNATIVE\",\"alternativeGroup\":\"pain_relief_options\",\"actionStatus\":\"NONE\",\"medication\":{\"name\":null,\"doseText\":null,\"frequencyText\":null,\"courseDurationText\":null,\"instructions\":\"오늘 두통에는 더 강한 진통제를 사용. Paracetamol 또는 Co-codamol, 또는 Ibuprofen 또는 Naproxen 같은 소염제를 고려\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f10\",\"support\":{\"statementIds\":[\"sc7d1c4933903v1u0127\",\"sc7d1c4933903v1u0128\",\"sc7d1c4933903v1u0131\",\"sc7d1c4933903v1u0132\",\"sc7d1c4933903v1u0133\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"FOLLOW_UP\",\"text\":\"두통이 더 지속되면 예방약을 생각해 볼 수 있으며, 2~3일 안에 좋아지지 않거나 더 심해지면 바로 다시 오고, 두통 악화·약에 반응하지 않음·목 통증 악화·팔다리 힘빠짐·시력 문제도 바로 재내원해야 함\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"FUTURE\",\"medication\":null,\"task\":{\"kind\":\"OTHER\",\"title\":\"재내원\",\"date\":null,\"time\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[]}],\"summaryFactIds\":[\"f7\",\"f5\",\"f8\",\"f9\",\"f10\"]}"
