      "annotations" : [ ],
      "logprobs" : [ ],
      "text" : "{\"schemaVersion\":\"1.0\",\"summary\":[{\"utteranceIds\":[\"s246c8d9f5bb8v1u0064\"],\"text\":\"감기와 기침으로 보아 단순한 바이러스 감염으로 판단함.\"},{\"utteranceIds\":[\"s246c8d9f5bb8v1u0061\",\"s246c8d9f5bb8v1u0064\"],\"text\":\"목 뒤가 약간 붉지만 편도는 커져 있지 않음.\"},{\"utteranceIds\":[\"s246c8d9f5bb8v1u0066\",\"s246c8d9f5bb8v1u0073\"],\"text\":\"Night Nurse와 Day Nurse를 사용해도 되며, 현재 약과 함께 써도 됨.\"},{\"utteranceIds\":[\"s246c8d9f5bb8v1u0068\",\"s246c8d9f5bb8v1u0069\",\"s246c8d9f5bb8v1u0073\"],\"text\":\"숨참, 쌕쌕거림, 3주 넘는 증상 등으로 상태가 나빠지면 연락하라고 안내함.\"},{\"utteranceIds\":[\"s246c8d9f5bb8v1u0075\"],\"text\":\"현재는 처방전이 필요 없다고 함.\"}],\"details\":{\"symptoms\":[{\"utteranceIds\":[\"s246c8d9f5bb8v1u0015\",\"s246c8d9f5bb8v1u0017\",\"s246c8d9f5bb8v1u0020\",\"s246c8d9f5bb8v1u0026\",\"s246c8d9f5bb8v1u0031\",\"s246c8d9f5bb8v1u0033\"],\"text\":\"약 5일간 기침, 콧물, 근육통, 간헐적 두통과 추위/오한 느낌이 있었고, 마른기침에 가래는 없으며 숨은 잘 쉬고 쌕쌕거리거나 그렁거림은 없음.\"},{\"utteranceIds\":[\"s246c8d9f5bb8v1u0041\",\"s246c8d9f5bb8v1u0045\"],\"text\":\"당뇨가 있고 약 5~6년째임.\"},{\"utteranceIds\":[\"s246c8d9f5bb8v1u0041\",\"s246c8d9f5bb8v1u0043\",\"s246c8d9f5bb8v1u0052\",\"s246c8d9f5bb8v1u0054\"],\"text\":\"혈압약을 복용 중이며 혈압은 오늘 아침 정상 범위였다고 함.\"}],\"tests\":[{\"utteranceIds\":[\"s246c8d9f5bb8v1u0061\"],\"text\":\"목 뒤가 약간 붉고 편도는 커져 있지 않음.\"},{\"utteranceIds\":[\"s246c8d9f5bb8v1u0063\",\"s246c8d9f5bb8v1u0064\"],\"text\":\"목 주변 멍울은 없고, 감기와 기침 소견으로 단순한 바이러스 감염 같다고 봄.\"}],\"medicationMentions\":[{\"utteranceIds\":[\"s246c8d9f5bb8v1u0035\",\"s246c8d9f5bb8v1u0038\",\"s246c8d9f5bb8v1u0039\"],\"text\":\"진통제를 먹었고, paracetamol로 확인되며 ibuprofen은 먹지 않았음.\"},{\"utteranceIds\":[\"s246c8d9f5bb8v1u0041\"],\"text\":\"평소 약으로 metformin과 lisinopril을 복용 중이라고 함.\"},{\"utteranceIds\":[\"s246c8d9f5bb8v1u0066\",\"s246c8d9f5bb8v1u0073\"],\"text\":\"Night Nurse, Day Nurse를 현재 약과 함께 사용할 수 있다고 안내함.\"}],\"precautions\":[{\"utteranceIds\":[\"s246c8d9f5bb8v1u0068\",\"s246c8d9f5bb8v1u0069\",\"s246c8d9f5bb8v1u0073\"],\"text\":\"숨이 차거나 쌕쌕거림이 생기거나 증상이 3주 넘게 지속되거나 상태가 나빠지면 연락하라고 함.\"},{\"utteranceIds\":[\"s246c8d9f5bb8v1u0075\"],\"text\":\"지금은 처방전이 필요 없다고 함.\"}],\"followUps\":[{\"utteranceIds\":[\"s246c8d9f5bb8v1u0068\",\"s246c8d9f5bb8v1u0069\"],\"text\":\"증상 변화나 악화가 있으면 연락.\"}]},\"items\":[{\"utteranceIds\":[\"s246c8d9f5bb8v1u0066\",\"s246c8d9f5bb8v1u0073\"],\"itemKey\":\"med_night_nurse_day_nurse\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"Night Nurse / Day Nurse\",\"doseText\":null,\"frequencyText\":null,\"startsOn\":null,\"endsOn\":null,\"instructions\":\"현재 약과 함께 써도 됨.\",\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[],\"isConditional\":false}]}"
