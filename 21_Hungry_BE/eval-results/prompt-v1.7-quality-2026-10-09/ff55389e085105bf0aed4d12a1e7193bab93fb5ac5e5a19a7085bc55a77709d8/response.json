      "text" : "{\"schemaVersion\":\"1.8\",\"facts\":[{\"factId\":\"f1\",\"support\":{\"statementIds\":[\"scaf7348c9ccfv1u0012\"],\"questionIds\":[],\"answerIds\": [],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"환자 이름은 Joe Bloggs이고 생년월일은 1974년 6월 7일이다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f2\",\"support\":{\"statementIds\":[\"scaf7348c9ccfv1u0017\",\"scaf7348c9ccfv1u0020\",\"scaf7348c9ccfv1u0021\",\"scaf7348c9ccfv1u0022\",\"scaf7348c9ccfv1u0023\",\"scaf7348c9ccfv1u0032\",\"scaf7348c9ccfv1u0037\",\"scaf7348c9ccfv1u0055\",\"scaf7348c9ccfv1u0057\",\"scaf7348c9ccfv1u0059\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"가슴 가운데의 압박감/불편감이 수 시간 전 갑자기 시작해 현재까지 지속되며, 10점 만점에 7점 정도이고 통증보다는 누가 가슴 위에 앉아 있는 느낌이다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f3\",\"support\":{\"statementIds\":[\"scaf7348c9ccfv1u0061\",\"scaf7348c9ccfv1u0063\",\"scaf7348c9ccfv1u0077\",\"scaf7348c9ccfv1u0079\",\"scaf7348c9ccfv1u0119\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"숨이 차고 약간 어지러우며, 계단이나 오르막길을 오를 때 더 힘들다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f4\",\"support\":{\"statementIds\":[\"scaf7348c9ccfv1u0093\",\"scaf7348c9ccfv1u0065\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"왼쪽 어깨와 팔에 약간의 통증이 있고, 종아리가 자주 아프며 다리가 붓기도 한다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f5\",\"support\":{\"statementIds\":[\"scaf7348c9ccfv1u0081\",\"scaf7348c9ccfv1u0082\",\"scaf7348c9ccfv1u0086\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"메스꺼움이 있으나 아직 구토는 없고, 현재도 메스꺼움이 있다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f6\",\"support\":{\"statementIds\":[\"scaf7348c9ccfv1u0049\",\"scaf7348c9ccfv1u0052\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"고혈압과 높은 콜레스테롤 병력이 있으며, 현재 관련 약은 복용하지 않는다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f7\",\"support\":{\"statementIds\":[\"scaf7348c9ccfv1u0103\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"계단이나 오르막길이 힘들어 집 안에서 움직이는 정도로 활동을 줄이고 너무 힘든 일은 하지 않는다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f8\",\"support\":{\"statementIds\":[\"scaf7348c9ccfv1u0068\",\"scaf7348c9ccfv1u0070\",\"scaf7348c9ccfv1u0071\",\"scaf7348c9ccfv1u0110\",\"scaf7348c9ccfv1u0115\",\"scaf7348c9ccfv1u0124\",\"scaf7348c9ccfv1u0128\",\"scaf7348c9ccfv1u0130\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"FOLLOW_UP\",\"text\":\"구급차를 불러 가능한 한 빨리 병원에 가며, 통화는 유지하고 구급대원에게 전달할 정보를 확인한다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"FUTURE\",\"medication\":null,\"task\":{\"kind\":\"HOSPITAL\",\"title\":\"병원 이송\",\"date\":null,\"time\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[]},{\"factId\":\"f9\",\"support\":{\"statementIds\":[\"scaf7348c9ccfv1u0107\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"FOLLOW_UP\",\"text\":\"아내에게 오늘 두 사람이 병원에 가게 될 것이며 필요한 물건을 챙겨야 할 수도 있다고 알린다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"FUTURE\",\"medication\":null,\"task\":{\"kind\":\"OTHER\",\"title\":\"아내에게 병원 이동 안내\",\"date\":null,\"time\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[]},{\"factId\":\"f10\",\"support\":{\"statementIds\":[\"scaf7348c9ccfv1u0112\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"그 약들은 먹지 않는다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"STOP\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":null,\"doseText\":null,\"frequencyText\":null,\"courseDurationText\":null,\"instructions\":\"원문에 약명이 없음\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[]}],\"summaryFactIds\":[\"f2\",\"f3\",\"f6\",\"f8\",\"f10\"]}"
