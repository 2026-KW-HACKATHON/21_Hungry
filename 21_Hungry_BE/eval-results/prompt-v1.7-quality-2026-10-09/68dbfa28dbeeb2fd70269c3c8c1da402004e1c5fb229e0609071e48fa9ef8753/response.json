      "text" : "{\"schemaVersion\":\"1.8\",\"facts\":[{\"factId\":\"f1\",\"support\":{\"statementIds\":[\"s43ec7b664b29v1u0012\",\"s43ec7b664b29v1u0014\",\"s43ec7b664b29v1u0029\",\"s43ec7b664b29v1u0032\",\"s43ec7b664b29v1u0051\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"최근 2~3일 동안 달리기나 빠르게 걸을 때 숨이 차고, 쌕쌕거림과 기침이 있으며 가래는 거의 없다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[\"UNCERTAIN\"]},{\"factId\":\"f2\",\"support\":{\"statementIds\":[\"s43ec7b664b29v1u0027\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"꽃가루 알레르기가 있다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f3\",\"support\":{\"statementIds\":[\"s43ec7b664b29v1u0037\",\"s43ec7b664b29v1u0040\",\"s43ec7b664b29v1u0048\",\"s43ec7b664b29v1u0054\",\"s43ec7b664b29v1u0059\",\"s43ec7b664b29v1u0066\",\"s43ec7b664b29v1u0068\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"천식은 최근 2~3일 전까지는 대체로 잘 조절되었고, 마지막 천식 발작은 3~4년 전이며 마지막 천식 점검은 2년 전쯤이었다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[\"UNCERTAIN\"]},{\"factId\":\"f4\",\"support\":{\"statementIds\":[\"s43ec7b664b29v1u0066\",\"s43ec7b664b29v1u0068\",\"s43ec7b664b29v1u0069\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"약 알레르기는 없다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f5\",\"support\":{\"statementIds\":[\"s43ec7b664b29v1u0042\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"예방을 위해 흡입기를 계속 쓰라고 했다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"HISTORICAL\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":null,\"doseText\":null,\"frequencyText\":null,\"courseDurationText\":null,\"instructions\":\"과거에 천식 악화 후 예방을 위해 계속 사용하라고 했다는 병력\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f6\",\"support\":{\"statementIds\":[\"s43ec7b664b29v1u0032\",\"s43ec7b664b29v1u0074\",\"s43ec7b664b29v1u0075\",\"s43ec7b664b29v1u0094\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"파란 흡입기는 필요할 때 쓰고, 최대 2~4시간마다 사용할 수 있다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"PRESCRIBED\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":\"Salbutamol\",\"doseText\":null,\"frequencyText\":\"필요할 때\",\"courseDurationText\":null,\"instructions\":\"최대 2~4시간마다 사용할 수 있다. 증상이 있을 때 사용한다.\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[\"UNCERTAIN\"]},{\"factId\":\"f7\",\"support\":{\"statementIds\":[\"s43ec7b664b29v1u0079\",\"s43ec7b664b29v1u0080\",\"s43ec7b664b29v1u0094\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"갈색 Clenil 흡입기를 하루 두 번, 한 번에 4번으로 늘리라고 했다.\",\"condition\":{\"operator\":\"ALL\",\"clauses\":[\"현재 하루 두 번, 한 번에 3번 흡입하고 있는 경우\"]},\"medicationRole\":\"PRESCRIBED\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":\"Clenil\",\"doseText\":\"한 번에 4번 흡입\",\"frequencyText\":\"하루 두 번\",\"courseDurationText\":null,\"instructions\":\"현재 하루 두 번, 한 번에 3번 흡입하고 있다면 한 번에 4번으로 늘린다. 저희 진료를 기다리는 동안 그렇게 한다.\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":\"DAILY\",\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f8\",\"support\":{\"statementIds\":[\"s43ec7b664b29v1u0072\",\"s43ec7b664b29v1u0093\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"FOLLOW_UP\",\"text\":\"앞으로 며칠 안에 주치의 진료를 받으라고 했다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"FUTURE\",\"medication\":null,\"task\":{\"kind\":\"EXAM\",\"title\":\"주치의 진료\",\"date\":null,\"time\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[]},{\"factId\":\"f9\",\"support\":{\"statementIds\":[\"s43ec7b664b29v1u0084\",\"s43ec7b664b29v1u0094\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"PRECAUTION\",\"text\":\"숨쉬기가 훨씬 나빠지면 응급실에 가야 하며 예약 진료를 기다리지 말아야 한다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"FUTURE\",\"medication\":null,\"task\":{\"kind\":\"HOSPITAL\",\"title\":\"응급실 방문\",\"date\":null,\"time\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[\"UNCERTAIN\"]},{\"factId\":\"f10\",\"support\":{\"statementIds\":[\"s43ec7b664b29v1u0087\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"TEST\",\"text\":\"진료에서 가슴을 진찰하고 최대호기유속을 재며, 결과에 따라 항생제나 스테로이드가 필요할 수도 있다고 했다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[\"UNCERTAIN\"]}],\"summaryFactIds\":[\"f3\",\"f6\",\"f7\",\"f8\",\"f9\"]}"
