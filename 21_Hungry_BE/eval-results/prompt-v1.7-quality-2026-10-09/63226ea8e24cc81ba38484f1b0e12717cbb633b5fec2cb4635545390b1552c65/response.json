      "text" : "{\n  \"schemaVersion\": \"1.8.1\",\n  \"facts\": [\n    {\n      \"factId\": \"f1\",\n      \"support\": {\n        \"statementIds\": [\"s359969f02aafv1u0001\"],\n        \"questionIds\": [],\n        \"answerIds\": [],\n        \"correctionIds\": []\n      },\n      \"kind\": \"MEDICATION\",\n      \"text\": \"환자는 예전에 가상 U약을 복용한 적이 있다고 말했다.\",\n      \"condition\": {\"operator\": \"NONE\", \"clauses\": []},\n      \"medicationRole\": \"HISTORICAL\",\n      \"alternativeGroup\": null,\n      \"actionStatus\": \"NONE\",\n      \"medication\": {\n        \"name\": \"가상 U약\",\n        \"doseText\": null,\n        \"frequencyText\": null,\n        \"courseDurationText\": null,\n        \"instructions\": null,\n        \"startsOn\": null,\n        \"endsOn\": null,\n        \"clockTimes\": [],\n        \"scheduleRecurrence\": null,\n        \"weekdays\": []\n      },\n      \"task\": null,\n      \"uncertaintyCodes\": []\n    },\n    {\n      \"factId\": \"f2\",\n      \"support\": {\n        \"statementIds\": [],\n        \"questionIds\": [\"s359969f02aafv1u0001\"],\n        \"answerIds\": [\"s359969f02aafv1u0002\"],\n        \"correctionIds\": []\n      },\n      \"kind\": \"MEDICATION\",\n      \"text\": \"의사는 예전에 복용한 가상 U약을 다시 복용하라는 뜻은 아니라고 설명했다.\",\n      \"condition\": {\"operator\": \"NONE\", \"clauses\": []},\n      \"medicationRole\": \"NONE\",\n      \"alternativeGroup\": null,\n      \"actionStatus\": \"NONE\",\n      \"medication\": null,\n      \"task\": null,\n      \"uncertaintyCodes\": []\n    },\n    {\n      \"factId\": \"f3\",\n      \"support\": {\n        \"statementIds\": [\"s359969f02aafv1u0002\"],\n        \"questionIds\": [],\n        \"answerIds\": [],\n        \"correctionIds\": [\"s359969f02aafv1u0002\"]\n      },\n      \"kind\": \"MEDICATION\",\n      \"text\": \"가상 V약은 1회 0.5정씩 하루 한 번, 엿새 동안 복용한다. 의사가 1회 2정을 0.5정으로 정정했으며, 복용 시각은 아직 정하지 않았다.\",\n      \"condition\": {\"operator\": \"NONE\", \"clauses\": []},\n      \"medicationRole\": \"PRESCRIBED\",\n      \"alternativeGroup\": null,\n      \"actionStatus\": \"FUTURE\",\n      \"medication\": {\n        \"name\": \"가상 V약\",\n        \"doseText\": \"1회 0.5정\",\n        \"frequencyText\": \"하루 한 번\",\n        \"courseDurationText\": \"엿새\",\n        \"instructions\": \"복용 시각은 아직 정하지 않음.\",\n        \"startsOn\": null,\n        \"endsOn\": null,\n        \"clockTimes\": [],\n        \"scheduleRecurrence\": null,\n        \"weekdays\": []\n      },\n      \"task\": null,\n      \"uncertaintyCodes\": []\n    },\n    {\n      \"factId\": \"f4\",\n      \"support\": {\n        \"statementIds\": [\"s359969f02aafv1u0002\", \"s359969f02aafv1u0003\"],\n        \"questionIds\": [],\n        \"answerIds\": [],\n        \"correctionIds\": []\n      },\n      \"kind\": \"MEDICATION\",\n      \"text\": \"나중에 가상 W약 또는 가상 X약 중 하나로 바꾸는 방법을 검토할 수 있다. 현재 함께 처방하는 것은 아니다.\",\n      \"condition\": {\n        \"operator\": \"ALL\",\n        \"clauses\": [\"가상 V약이 맞지 않는 경우\"]\n      },\n      \"medicationRole\": \"ALTERNATIVE\",\n      \"alternativeGroup\": \"a1\",\n      \"actionStatus\": \"NONE\",\n      \"medication\": {\n        \"name\": null,\n        \"doseText\": null,\n        \"frequencyText\": null,\n        \"courseDurationText\": null,\n        \"instructions\": \"가상 V약이 맞지 않으면 나중에 가상 W약 또는 가상 X약 중 하나로 변경하는 방법을 검토할 수 있음. 선택된 약은 없으며 현재 함께 처방하는 것은 아님.\",\n        \"startsOn\": null,\n        \"endsOn\": null,\n        \"clockTimes\": [],\n        \"scheduleRecurrence\": null,\n        \"weekdays\": []\n      },\n      \"task\": null,\n      \"uncertaintyCodes\": []\n    },\n    {\n      \"factId\": \"f5\",\n      \"support\": {\n        \"statementIds\": [\"s359969f02aafv1u0005\"],\n        \"questionIds\": [],\n        \"answerIds\": [],\n        \"correctionIds\": []\n      },\n      \"kind\": \"FOLLOW_UP\",\n      \"text\": \"즉시 병원에 온다.\",\n      \"condition\": {\n        \"operator\": \"ALL\",\n        \"clauses\": [\"숨이 차는 증상이 생김\", \"입술이 붓는 증상도 함께 생김\"]\n      },\n      \"medicationRole\": \"NONE\",\n      \"alternativeGroup\": null,\n      \"actionStatus\": \"FUTURE\",\n      \"medication\": null,\n      \"task\": {\n        \"kind\": \"HOSPITAL\",\n        \"title\": \"숨참과 입술 부종이 함께 생기면 즉시 내원\",\n        \"date\": null,\n        \"time\": null,\n        \"recurrence\": \"ONCE\",\n        \"lastDate\": null,\n        \"weekdays\": []\n      },\n      \"uncertaintyCodes\": []\n    },\n    {\n      \"factId\": \"f6\",\n      \"support\": {\n        \"statementIds\": [],\n        \"questionIds\": [\"s359969f02aafv1u0004\"],\n        \"answerIds\": [\"s359969f02aafv1u0005\"],\n        \"correctionIds\": []\n      },\n      \"kind\": \"FOLLOW_UP\",\n      \"text\": \"다음 주 수요일에 무조건 재방문해야 하는 것은 아니며, 날짜를 정해 예약한 것도 아니다.\",\n      \"condition\": {\"operator\": \"NONE\", \"clauses\": []},\n      \"medicationRole\": \"NONE\",\n      \"alternativeGroup\": null,\n      \"actionStatus\": \"NONE\",\n      \"medication\": null,\n      \"task\": null,\n      \"uncertaintyCodes\": []\n    }\n  ],\n  \"summaryFactIds\": [\"f2\", \"f3\", \"f4\", \"f5\", \"f6\"]\n}"
