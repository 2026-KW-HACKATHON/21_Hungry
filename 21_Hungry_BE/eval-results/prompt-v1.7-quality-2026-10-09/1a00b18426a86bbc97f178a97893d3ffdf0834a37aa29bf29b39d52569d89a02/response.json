      "text" : "{\"schemaVersion\":\"1.8\",\"facts\":[{\"factId\":\"f1\",\"support\":{\"statementIds\":[\"s71c55c29c708v1u0013\",\"s71c55c29c708v1u0017\",\"s71c55c29c708v1u0015\",\"s71c55c29c708v1u0021\",\"s71c55c29c708v1u0023\",\"s71c55c29c708v1u0026\",\"s71c55c29c708v1u0028\",\"s71c55c29c708v1u0031\",\"s71c55c29c708v1u0033\",\"s71c55c29c708v1u0035\",\"s71c55c29c708v1u0038\",\"s71c55c29c708v1u0040\",\"s71c55c29c708v1u0042\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"약 3일째 설사가 있고, 하루 5~6번의 묽고 물 같은 변을 본다. 구토는 멈췄고, 혈변은 없다고 한다. 설사와 함께 탈수된 느낌, 식욕 저하, 기운 없음이 있다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[\"APPROXIMATE_DURATION\",\"PATIENT_REPORT\",\"NEGATED\"]},{\"factId\":\"f2\",\"support\":{\"statementIds\":[\"s71c55c29c708v1u0082\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"설명상 위장염(gastroenteritis)일 가능성이 있다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[\"CLINICIAN_GUESS\"]},{\"factId\":\"f3\",\"support\":{\"statementIds\":[\"s71c55c29c708v1u0085\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"PRECAUTION\",\"text\":\"물을 충분히 마시라고 권했다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f4\",\"support\":{\"statementIds\":[\"s71c55c29c708v1u0087\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"Dioralyte를 약국에서 구할 수 있으며, 잃은 미네랄과 비타민을 보충하는 데 도움이 되는 수분 보충 음료라고 설명했다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"EXAMPLE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":\"Dioralyte\",\"doseText\":null,\"frequencyText\":null,\"courseDurationText\":null,\"instructions\":\"약국에서 구할 수 있는 수분 보충 음료로 설명됨\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f5\",\"support\":{\"statementIds\":[\"s71c55c29c708v1u0090\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"열이 나고 기운이 없으면 Paracetamol을 복용해도 된다고 했다.\",\"condition\":{\"operator\":\"ALL\",\"clauses\":[\"열이 나고 기운이 없으면\"]},\"medicationRole\":\"CONDITIONAL\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":\"Paracetamol\",\"doseText\":null,\"frequencyText\":null,\"courseDurationText\":null,\"instructions\":\"열이 나고 기운이 없을 때만 복용\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f6\",\"support\":{\"statementIds\":[\"s71c55c29c708v1u0092\",\"s71c55c29c708v1u0093\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"FOLLOW_UP\",\"text\":\"나아질 때까지 앞으로 하루 이틀 더 일을 쉬고, 설사가 멎은 뒤 24~48시간이 지나야 일터로 돌아갈 수 있다고 권했다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"FUTURE\",\"medication\":null,\"task\":{\"kind\":\"OTHER\",\"title\":\"일 쉬기 및 복귀 시점 지키기\",\"date\":null,\"time\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[]},{\"factId\":\"f7\",\"support\":{\"statementIds\":[\"s71c55c29c708v1u0095\",\"s71c55c29c708v1u0099\"] ,\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"FOLLOW_UP\",\"text\":\"앞으로 며칠 경과를 보고, 다음 주에도 낫지 않으면 다시 진료받으러 오라고 했다. 환자는 안 나으면 다시 전화하겠다고 했다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"FUTURE\",\"medication\":null,\"task\":{\"kind\":\"EXAM\",\"title\":\"다음 주에도 호전 없으면 다시 진료\",\"date\":null,\"time\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[]}],\"summaryFactIds\":[\"f2\",\"f3\",\"f5\",\"f6\",\"f7\"]}"
