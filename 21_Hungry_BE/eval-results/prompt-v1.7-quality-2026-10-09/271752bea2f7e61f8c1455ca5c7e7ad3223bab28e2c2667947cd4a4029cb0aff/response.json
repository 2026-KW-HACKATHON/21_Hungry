      "annotations" : [ ],
      "logprobs" : [ ],
      "text" : "{\"schemaVersion\":\"1.8\",\"facts\":[{\"factId\":\"f1\",\"support\":{\"statementIds\":[\"s251d066cf3afv1u0003\",\"s251d066cf3afv1u0005\",\"s251d066cf3afv1u0008\",\"s251d066cf3afv1u0010\",\"s251d066cf3afv1u0013\",\"s251d066cf3afv1u0015\",\"s251d066cf3afv1u0017\",\"s251d066cf3afv1u0019\",\"s251d066cf3afv1u0021\",\"s251d066cf3afv1u0030\",\"s251d066cf3afv1u0034\",\"s251d066cf3afv1u0038\",\"s251d066cf3afv1u0057\",\"s251d066cf3afv1u0072\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"지난 사흘 동안 물 같고 묽은 설사가 하루 6~7회 있었고, 왼쪽 아랫배 통증이 있으며, 통증은 간헐적이고 쥐나는 듯한 느낌이다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f2\",\"support\":{\"statementIds\":[\"s251d066cf3afv1u0010\",\"s251d066cf3afv1u0024\",\"s251d066cf3afv1u0030\",\"s251d066cf3afv1u0032\",\"s251d066cf3afv1u0072\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"혈변은 없었고, 증상 시작 당시에는 열감이 있었으나 현재는 열이 없다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f3\",\"support\":{\"statementIds\":[\"s251d066cf3afv1u0034\",\"s251d066cf3afv1u0038\",\"s251d066cf3afv1u0081\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"SYMPTOM\",\"text\":\"구토는 처음에 있었으나 지금은 멈췄고, 물은 유지할 수 있으며 수프나 가벼운 음식, 스무디 같은 액체 음식을 먹고 있다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f4\",\"support\":{\"statementIds\":[\"s251d066cf3afv1u0041\",\"s251d066cf3afv1u0044\",\"s251d066cf3afv1u0072\",\"s251d066cf3afv1u0076\",\"s251d066cf3afv1u0078\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"ASSESSMENT\",\"text\":\"사흘 전 중국 음식점에서 포장 음식을 먹은 뒤 시작된 위장염일 수 있으며, 바이러스가 원인일 가능성이 크지만 세균도 가능하다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":null,\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f5\",\"support\":{\"statementIds\":[\"s251d066cf3afv1u0081\",\"s251d066cf3afv1u0084\",\"s251d066cf3afv1u0086\",\"s251d066cf3afv1u0088\",\"s251d066cf3afv1u0090\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"보존적 관리가 권해졌고, 수분을 잘 유지하도록 물 같은 것을 마시며, 약국에서 구할 수 있는 Dioralyte 같은 것을 고려할 수 있고, 열감과 무기력감이 있으면 처음 며칠 동안 paracetamol 두 정씩 하루 최대 네 번 복용할 수 있다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"PRESCRIBED\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":\"paracetamol\",\"doseText\":\"두 정\",\"frequencyText\":\"하루 최대 네 번\",\"courseDurationText\":\"처음 며칠 동안\",\"instructions\":\"열감과 힘이 없으면 복용할 수 있다.\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f6\",\"support\":{\"statementIds\":[\"s251d066cf3afv1u0081\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"MEDICATION\",\"text\":\"항생제는 필요하지 않을 것 같다.\",\"condition\":{\"operator\":\"NONE\",\"clauses\":[]},\"medicationRole\":\"STOP\",\"alternativeGroup\":null,\"actionStatus\":\"NONE\",\"medication\":{\"name\":null,\"doseText\":null,\"frequencyText\":null,\"courseDurationText\":null,\"instructions\":\"항생제 같은 것은 필요하지 않을 것 같다.\",\"startsOn\":null,\"endsOn\":null,\"clockTimes\":[],\"scheduleRecurrence\":null,\"weekdays\":[]},\"task\":null,\"uncertaintyCodes\":[]},{\"factId\":\"f7\",\"support\":{\"statementIds\":[\"s251d066cf3afv1u0090\",\"s251d066cf3afv1u0093\",\"s251d066cf3afv1u0095\",\"s251d066cf3afv1u0097\"],\"questionIds\":[],\"answerIds\":[],\"correctionIds\":[]},\"kind\":\"FOLLOW_UP\",\"text\":\"앞으로 이틀에서 사흘 동안 쉬고 휴식하며, 3~4일 동안 증상이 좋아지지 않으면 다시 와서 보고, 계속되면 추가 검사로 대변 검체 검사가 필요할 수 있다.\",\"condition\":{\"operator\":\"COMPLEX\",\"clauses\":[\"앞으로 이틀에서 사흘 동안 감염이 몸에서 없어지는 동안 쉬면서 휴식한다\",\"사흘에서 나흘 동안 증상이 좋아지지 않는다\",\"계속된다\"]},\"medicationRole\":\"NONE\",\"alternativeGroup\":null,\"actionStatus\":\"FUTURE\",\"medication\":null,\"task\":{\"kind\":\"EXAM\",\"title\":\"대변 검체 검사\",\"date\":null,\"time\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[]}],\"summaryFactIds\":[\"f1\",\"f4\",\"f5\",\"f7\"]}"
