      "annotations" : [ ],
      "logprobs" : [ ],
      "text" : "{\"schemaVersion\":\"1.0\",\"summary\":[{\"text\":\"최근 2~3일 사이 달리기 후와 빠르게 걸을 때 숨참, 쌕쌕거림, 기침이 생겼고 파란 흡입기는 효과가 없었다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0012\",\"s43ec7b664b29v1u0014\"]},{\"text\":\"한동안 천식 조절이 비교적 좋았지만 최근 악화 가능성이 있으며, 마지막 천식 발작은 3~4년 전, 마지막 천식 점검은 2년 전쯤이었다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0050\",\"s43ec7b664b29v1u0051\",\"s43ec7b664b29v1u0040\",\"s43ec7b664b29v1u0048\"]},{\"text\":\"꽃가루 알레르기가 있고 약 알레르기는 없으며, 천식으로 입원한 적은 없다고 했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0066\",\"s43ec7b664b29v1u0068\",\"s43ec7b664b29v1u0037\"]},{\"text\":\"파란 흡입기(Salbutamol)는 증상 있을 때 쓰는 편이고, 갈색 흡입기(Clenil)는 하루 2번 매회 3번 흡입에서 4번으로 늘리라고 했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0032\",\"s43ec7b664b29v1u0077\",\"s43ec7b664b29v1u0079\",\"s43ec7b664b29v1u0080\",\"s43ec7b664b29v1u0094\"]},{\"text\":\"며칠 안에 주치의 진료를 받고, 숨쉬기가 더 나빠지면 예약을 기다리지 말고 응급실로 가라고 했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0072\",\"s43ec7b664b29v1u0093\",\"s43ec7b664b29v1u0084\",\"s43ec7b664b29v1u0094\"]}],\"details\":{\"symptoms\":[{\"text\":\"2~3일 전 친구와 달린 뒤 숨이 찼고, 지금은 빨리 걸으면 확실히 숨차며 쌕쌕거림과 기침이 있다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0012\",\"s43ec7b664b29v1u0014\"]},{\"text\":\"가래는 거의 없다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0028\",\"s43ec7b664b29v1u0029\"]},{\"text\":\"예방하려고 아침이나 저녁에도 파란 흡입기를 사용한다고 했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0017\",\"s43ec7b664b29v1u0018\"]}],\"tests\":[{\"text\":\"집에서 최대호기유속계를 가끔 사용했지만 증상이 생긴 뒤로는 사용하지 않았고, 평소 수치는 약 380 정도로 확인했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0052\",\"s43ec7b664b29v1u0054\",\"s43ec7b664b29v1u0059\",\"s43ec7b664b29v1u0060\"]},{\"text\":\"다음 진료에서 가슴 진찰과 최대호기유속 측정을 하며, 결과에 따라 항생제나 스테로이드가 필요할 수 있다고 했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0085\",\"s43ec7b664b29v1u0087\"]}],\"medicationMentions\":[{\"text\":\"Salbutamol은 파란 흡입기로, 증상이 있을 때 쓰는 편이며 최대 2~4시간마다 사용할 수 있다고 했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0016\",\"s43ec7b664b29v1u0020\",\"s43ec7b664b29v1u0074\",\"s43ec7b664b29v1u0075\",\"s43ec7b664b29v1u0094\"]},{\"text\":\"Clenil은 갈색 흡입기로, 하루 2번 매회 3번 흡입하던 것을 4번으로 늘리라고 했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0032\",\"s43ec7b664b29v1u0077\",\"s43ec7b664b29v1u0079\",\"s43ec7b664b29v1u0080\",\"s43ec7b664b29v1u0094\"]},{\"text\":\"Cetraben과 Hydrocortisone을 사용 중이라고 했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0023\"]},{\"text\":\"Flanel, Bactroban도 언급됐지만 이후에는 Cetraben과 Hydrocortisone으로 다시 말했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0020\",\"s43ec7b664b29v1u0023\"]}],\"precautions\":[{\"text\":\"숨쉬기가 훨씬 나빠지면 예약 진료를 기다리지 말고 응급실로 가라고 했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0084\",\"s43ec7b664b29v1u0094\"]},{\"text\":\"파란 흡입기를 너무 자주 써야 한다면 천식이 상당히 안 좋은 상태라는 설명이 있었다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0075\"]}],\"followUps\":[{\"text\":\"앞으로 며칠 안에 주치의 중 한 명에게 진료를 받으라고 했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0072\"]},{\"text\":\"지원팀에 연락해 예약하고 대면 진료를 권했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0093\"]},{\"text\":\"다음 진료에서 흉부 진찰과 최대호기유속 측정을 하기로 했다.\",\"utteranceIds\":[\"s43ec7b664b29v1u0085\",\"s43ec7b664b29v1u0087\"]}]},\"items\":[{\"itemKey\":\"med1\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"Salbutamol\",\"doseText\":null,\"frequencyText\":\"증상 있을 때 사용, 최대 2~4시간마다\",\"startsOn\":null,\"endsOn\":null,\"instructions\":\"파란 흡입기\",\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[],\"isConditional\":true,\"utteranceIds\":[\"s43ec7b664b29v1u0016\",\"s43ec7b664b29v1u0020\",\"s43ec7b664b29v1u0074\",\"s43ec7b664b29v1u0075\",\"s43ec7b664b29v1u0094\"]},{\"itemKey\":\"med2\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"Clenil\",\"doseText\":\"한 번에 4번 흡입\",\"frequencyText\":\"하루 2번\",\"startsOn\":null,\"endsOn\":null,\"instructions\":\"갈색 흡입기; 기존 1회 3번에서 증량\",\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[],\"isConditional\":false,\"utteranceIds\":[\"s43ec7b664b29v1u0077\",\"s43ec7b664b29v1u0079\",\"s43ec7b664b29v1u0080\",\"s43ec7b664b29v1u0094\"]},{\"itemKey\":\"med3\",\"itemType\":\"MEDICATION\