      "logprobs" : [ ],
      "text" : "{\"schemaVersion\":\"1.0\",\"summary\":[{\"text\":\"말벌에 쏘인 뒤 숨쉬기 어려움과 입술 따끔거림, 가벼운 가슴 답답함, 얼룩 같은 발진이 나타나 아나필락시스 가능성을 걱정해 즉시 진료가 필요하다고 판단됨.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0014\",\"s97cb05c5daa7v1u0016\",\"s97cb05c5daa7v1u0020\",\"s97cb05c5daa7v1u0028\",\"s97cb05c5daa7v1u0036\",\"s97cb05c5daa7v1u0039\",\"s97cb05c5daa7v1u0043\"]},{\"text\":\"구급차를 부르라고 안내했고, 병원으로 바로 가라고 권고함.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0041\",\"s97cb05c5daa7v1u0043\",\"s97cb05c5daa7v1u0046\",\"s97cb05c5daa7v1u0048\"]}],\"details\":{\"symptoms\":[{\"text\":\"약 15분 전 정원 가꾸다 말벌에 쏘인 뒤 실내로 들어옴.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0014\"]},{\"text\":\"그 뒤 숨을 상당히 얕게 쉬고 숨쉬기 어려워짐.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0016\",\"s97cb05c5daa7v1u0017\"]},{\"text\":\"입술에 따끔거리는 느낌이 있음. 목 조임은 없다고 함.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0019\",\"s97cb05c5daa7v1u0020\",\"s97cb05c5daa7v1u0021\",\"s97cb05c5daa7v1u0022\"]},{\"text\":\"가슴이 조금 답답함.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0027\",\"s97cb05c5daa7v1u0028\"]},{\"text\":\"몸에 얼룩처럼 조금 발진이 생김.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0035\",\"s97cb05c5daa7v1u0036\"]},{\"text\":\"이런 일은 처음이라고 함.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0025\",\"s97cb05c5daa7v1u0026\"]},{\"text\":\"습진이 조금 있고 penicillin 알레르기가 있음.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0030\"]}],\"tests\":[],\"medicationMentions\":[{\"text\":\"집에 있는 항히스타민제를 구급차가 오는 동안 아내가 주도록 안내함.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0041\",\"s97cb05c5daa7v1u0046\"]},{\"text\":\"해당 항히스타민제는 비행할 때 쓰는 약으로, 항공성 부비동염 때문에 가지고 있다고 함.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0040\"]}],\"precautions\":[{\"text\":\"숨쉬기 어려워질 수 있어 빠르게 대처해야 하므로 아내가 직접 데려가는 대신 구급차를 부르라고 함.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0041\",\"s97cb05c5daa7v1u0043\",\"s97cb05c5daa7v1u0048\"]},{\"text\":\"아나필락시스 반응 가능성을 걱정한다고 설명함.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0043\"]},{\"text\":\"조심하라고 안내함.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0052\"]}],\"followUps\":[{\"text\":\"즉시 진료를 받아야 한다고 판단했으며 병원에 바로 가라고 권고함.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0039\",\"s97cb05c5daa7v1u0046\",\"s97cb05c5daa7v1u0047\"]},{\"text\":\"구급차를 불러 빨리 처치받으라고 함.\",\"utteranceIds\":[\"s97cb05c5daa7v1u0043\",\"s97cb05c5daa7v1u0048\"]}]},\"items\":[{\"itemKey\":\"task-1\",\"itemType\":\"TASK\",\"payload\":{\"schemaVersion\":1,\"kind\":\"HOSPITAL\",\"title\":\"구급차로 병원 이송\",\"description\":\"숨쉬기 어려워질 수 있어 아내가 직접 데려가지 말고 구급차를 부른 뒤 병원에 바로 가기\",\"date\":\"2026-10-07\",\"time\":null,\"durationMinutes\":null,\"durationSource\":null,\"recurrence\":\"ONCE\",\"lastDate\":\"2026-10-07\",\"weekdays\":[]},\"uncertaintyCodes\":[],\"isConditional\":false,\"utteranceIds\":[\"s97cb05c5daa7v1u0041\",\"s97cb05c5daa7v1u0043\",\"s97cb05c5daa7v1u0046\",\"s97cb05c5daa7v1u0048\"]},{\"itemKey\":\"med-1\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"항히스타민제\",\"doseText\":null,\"frequencyText\":null,\"startsOn\":null,\"endsOn\":null,\"instructions\":\"구급차가 오는 동안 아내가 주도록 안내됨\",\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[],\"isConditional\":true,\"utteranceIds\":[\"s97cb05c5daa7v1u0041\",\"s97cb05c5daa7v1u0046\"]}]}"
