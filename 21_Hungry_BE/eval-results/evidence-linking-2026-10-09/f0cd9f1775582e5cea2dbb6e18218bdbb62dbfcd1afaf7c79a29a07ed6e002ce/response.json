      "annotations" : [ ],
      "logprobs" : [ ],
      "text" : "{\"schemaVersion\":\"1.0\",\"summary\":[{\"text\":\"왼팔이 움직이지 않고 왼쪽 얼굴 저림과 삼키기 어려움, 말하기 저하가 약 1시간째 이어져 뇌졸중 가능성이 제기됨.\",\"utteranceIds\":[\"s7121299c0f76v1u0018\",\"s7121299c0f76v1u0022\",\"s7121299c0f76v1u0035\",\"s7121299c0f76v1u0037\",\"s7121299c0f76v1u0044\",\"s7121299c0f76v1u0046\",\"s7121299c0f76v1u0051\"]},{\"text\":\"응급으로 병원에 가야 한다고 판단되어 구급차가 요청됨.\",\"utteranceIds\":[\"s7121299c0f76v1u0053\",\"s7121299c0f76v1u0055\",\"s7121299c0f76v1u0086\"]},{\"text\":\"오른쪽/왼쪽 혼동 없음, 손 색깔 변화 없음, 손이 차갑지 않음, 이전에도 같은 증상은 없었음.\",\"utteranceIds\":[\"s7121299c0f76v1u0026\",\"s7121299c0f76v1u0027\",\"s7121299c0f76v1u0030\",\"s7121299c0f76v1u0031\",\"s7121299c0f76v1u0032\",\"s7121299c0f76v1u0033\"]},{\"text\":\"기저질환으로 제2형 당뇨병과 고혈압이 있고, 복용 약은 metformin, losartan, amlodipine임.\",\"utteranceIds\":[\"s7121299c0f76v1u0062\",\"s7121299c0f76v1u0064\"]},{\"text\":\"혼자 살며, 과거 흡연력이 있고 주말과 주중에 맥주를 파인트로 마신다고 함.\",\"utteranceIds\":[\"s7121299c0f76v1u0074\",\"s7121299c0f76v1u0076\",\"s7121299c0f76v1u0078\",\"s7121299c0f76v1u0080\"]}],\"details\":{\"symptoms\":[{\"text\":\"아침에 일어난 뒤 약 1시간부터 왼팔을 움직일 수 없었고, 통증은 없다고 함.\",\"utteranceIds\":[\"s7121299c0f76v1u0014\",\"s7121299c0f76v1u0018\",\"s7121299c0f76v1u0022\",\"s7121299c0f76v1u0024\"]},{\"text\":\"왼쪽 얼굴이 따끔거리고, 물을 마실 때 삼키기 어렵고, 말하기가 전보다 힘들고 느리다고 함.\",\"utteranceIds\":[\"s7121299c0f76v1u0035\",\"s7121299c0f76v1u0037\",\"s7121299c0f76v1u0042\",\"s7121299c0f76v1u0044\",\"s7121299c0f76v1u0046\"]},{\"text\":\"증상은 계속되어 팔은 여전히 움직이지 않고 말하기는 더 힘들어졌다고 함.\",\"utteranceIds\":[\"s7121299c0f76v1u0084\",\"s7121299c0f76v1u0085\"]}],\"tests\":[{\"text\":\"전화 진료로 얼굴을 직접 볼 수 없어 안면 비대칭 여부는 확인되지 않았음.\",\"utteranceIds\":[\"s7121299c0f76v1u0039\"]}],\"medicationMentions\":[{\"text\":\"복용 약으로 metformin, losartan, amlodipine을 언급함.\",\"utteranceIds\":[\"s7121299c0f76v1u0063\",\"s7121299c0f76v1u0064\"]}],\"precautions\":[{\"text\":\"응급으로 병원에 가야 하며, 구급차 도착 전에는 현관문 잠금을 풀어 두고 복도에 앉아 기다리라고 함.\",\"utteranceIds\":[\"s7121299c0f76v1u0053\",\"s7121299c0f76v1u0055\"]},{\"text\":\"구급대원이 쉽게 들어올 수 있도록 문을 열어 두고 복도에서 기다리라고 함.\",\"utteranceIds\":[\"s7121299c0f76v1u0090\"]}],\"followUps\":[{\"text\":\"구급차가 집 주소로 요청되었고, 도착할 때까지 통화하며 대기하기로 함.\",\"utteranceIds\":[\"s7121299c0f76v1u0055\",\"s7121299c0f76v1u0086\",\"s7121299c0f76v1u0087\",\"s7121299c0f76v1u0092\"]},{\"text\":\"가까운 응급실에서 뇌졸중 담당 의사가 진찰하고 치료를 판단할 예정이라고 설명함.\",\"utteranceIds\":[\"s7121299c0f76v1u0086\"]}]},\"items\":[{\"itemKey\":\"med1\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"metformin\",\"doseText\":null,\"frequencyText\":null,\"startsOn\":null,\"endsOn\":null,\"instructions\":null,\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[],\"isConditional\":false,\"utteranceIds\":[\"s7121299c0f76v1u0064\"]},{\"itemKey\":\"med2\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"losartan\",\"doseText\":null,\"frequencyText\":null,\"startsOn\":null,\"endsOn\":null,\"instructions\":null,\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[],\"isConditional\":false,\"utteranceIds\":[\"s7121299c0f76v1u0064\"]},{\"itemKey\":\"med3\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"amlodipine\",\"doseText\":null,\"frequencyText\":null,\"startsOn\":null,\"endsOn\":null,\"instructions\":null,\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[],\"isConditional\":false,\"utteranceIds\":[\"s7121299c0f76v1u0064\"]},{\"itemKey\":\"task1\",\"itemType\":\"TASK\",\"payload\":{\"schemaVersion\":1,\"kind\":\"HOSPITAL\",\"title\":\"응급실 방문\",\"description\":\"구급차로 가까운 응급실에 가서 뇌졸중 평가와 치료 판단을 받음\",\"date\":null,\"time\":null,\"durationMinutes\":null,\"durationSource\":null,\"recurrence\":null,\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[],\"isConditional\":false,\"utteranceIds\":[\"s7121299c0f76v1u0053\",\"s7121299c0f76v1u0055\",\"s7121299c0f76v1u0086\"]}]}"
