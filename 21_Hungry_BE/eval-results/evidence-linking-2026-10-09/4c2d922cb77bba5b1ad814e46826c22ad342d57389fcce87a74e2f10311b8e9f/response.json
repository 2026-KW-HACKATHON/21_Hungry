      "annotations" : [ ],
      "logprobs" : [ ],
      "text" : "{\"schemaVersion\":\"1.0\",\"summary\":[{\"text\":\"왼쪽 귀 청력 저하와 간헐적 이명, 가벼운 메스꺼움/균형감 이상이 6주째 이어짐.\",\"utteranceIds\":[\"s5bb533f54674v1u0012\",\"s5bb533f54674v1u0014\",\"s5bb533f54674v1u0018\",\"s5bb533f54674v1u0020\",\"s5bb533f54674v1u0048\"]},{\"text\":\"의사는 귀지 같은 막힘 여부를 먼저 확인해야 하며, 귀 안과 고막을 봐야 한다고 설명함.\",\"utteranceIds\":[\"s5bb533f54674v1u0037\",\"s5bb533f54674v1u0038\",\"s5bb533f54674v1u0040\",\"s5bb533f54674v1u0041\",\"s5bb533f54674v1u0055\",\"s5bb533f54674v1u0056\",\"s5bb533f54674v1u0057\"]},{\"text\":\"진료소 대면 진료를 4~5일 안에 예약하라고 안내했고, 응급은 아니라고 함.\",\"utteranceIds\":[\"s5bb533f54674v1u0042\",\"s5bb533f54674v1u0043\",\"s5bb533f54674v1u0044\",\"s5bb533f54674v1u0070\",\"s5bb533f54674v1u0074\"]}],\"details\":{\"symptoms\":[{\"text\":\"왼쪽 귀만 잘 안 들리고 가끔 삐 소리가 남.\",\"utteranceIds\":[\"s5bb533f54674v1u0012\",\"s5bb533f54674v1u0018\",\"s5bb533f54674v1u0020\"]},{\"text\":\"증상은 6주 정도 지속됐고, 왔다 갔다 하며 TV나 음악을 들을 때 달라지는 것 같다고 함.\",\"utteranceIds\":[\"s5bb533f54674v1u0014\",\"s5bb533f54674v1u0026\",\"s5bb533f54674v1u0027\"]},{\"text\":\"메스꺼움이 몇 번 있었고, 심하지 않은 어지럼으로 방이 도는 느낌보다는 균형이 조금 안 맞는 느낌이라고 함.\",\"utteranceIds\":[\"s5bb533f54674v1u0018\",\"s5bb533f54674v1u0032\",\"s5bb533f54674v1u0048\"]},{\"text\":\"귀 통증은 없다고 했고, 오른쪽 귀는 괜찮은 것 같다고 함.\",\"utteranceIds\":[\"s5bb533f54674v1u0029\",\"s5bb533f54674v1u0022\"]}],\"tests\":[{\"text\":\"귀 안과 고막을 직접 확인해야 한다고 설명함.\",\"utteranceIds\":[\"s5bb533f54674v1u0037\",\"s5bb533f54674v1u0041\",\"s5bb533f54674v1u0055\"]},{\"text\":\"귀지 같은 단순한 원인인지 먼저 보고, 막힘이 있으면 해결해야 한다고 함.\",\"utteranceIds\":[\"s5bb533f54674v1u0038\",\"s5bb533f54674v1u0040\",\"s5bb533f54674v1u0057\"]},{\"text\":\"이명은 tinnitus라고 설명함.\",\"utteranceIds\":[\"s5bb533f54674v1u0059\"]}],\"medicationMentions\":[],\"precautions\":[{\"text\":\"면봉으로 귀를 청소하지 말라고 함.\",\"utteranceIds\":[\"s5bb533f54674v1u0035\",\"s5bb533f54674v1u0037\"]},{\"text\":\"대면 진료 전까지 안내 자료 링크를 읽어 보라고 함.\",\"utteranceIds\":[\"s5bb533f54674v1u0065\",\"s5bb533f54674v1u0069\"]},{\"text\":\"진료 전에 문제가 생기면 다른 화상 진료를 예약해 상담하라고 함.\",\"utteranceIds\":[\"s5bb533f54674v1u0076\"]}],\"followUps\":[{\"text\":\"진료소 대면 진료를 4~5일 안에 받도록 예약 요청됨.\",\"utteranceIds\":[\"s5bb533f54674v1u0042\",\"s5bb533f54674v1u0043\",\"s5bb533f54674v1u0044\",\"s5bb533f54674v1u0070\"]},{\"text\":\"지원팀에 전화하면 예약을 잡아 주기로 함.\",\"utteranceIds\":[\"s5bb533f54674v1u0074\"]}]},\"items\":[{\"itemKey\":\"followup-1\",\"itemType\":\"TASK\",\"payload\":{\"schemaVersion\":1,\"kind\":\"HOSPITAL\",\"title\":\"대면 진료 예약\",\"description\":\"진료소에서 귀를 확인하는 대면 진료를 4~5일 안에 받도록 예약\",\"date\":null,\"time\":null,\"durationMinutes\":null,\"durationSource\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[],\"isConditional\":false,\"utteranceIds\":[\"s5bb533f54674v1u0042\",\"s5bb533f54674v1u0043\",\"s5bb533f54674v1u0044\",\"s5bb533f54674v1u0070\",\"s5bb533f54674v1u0074\"]}]}"
