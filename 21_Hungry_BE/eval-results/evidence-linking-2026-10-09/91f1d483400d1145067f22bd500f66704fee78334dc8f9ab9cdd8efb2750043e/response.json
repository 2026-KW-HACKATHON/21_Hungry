      "annotations" : [ ],
      "logprobs" : [ ],
      "text" : "{\"schemaVersion\":\"1.0\",\"summary\":[{\"text\":\"어지럼, 구역감, 방이 도는 느낌과 보행 불안정이 약 2시간째 지속되고, 한 달 전에도 5~10분 정도 비슷한 증상이 있었음.\",\"utteranceIds\":[\"s16d1fd758b58v1u0018\",\"s16d1fd758b58v1u0020\",\"s16d1fd758b58v1u0024\",\"s16d1fd758b58v1u0035\",\"s16d1fd758b58v1u0055\"]},{\"text\":\"의사는 가장 흔한 진단으로 labyrinthitis(미로염)를 언급함.\",\"utteranceIds\":[\"s16d1fd758b58v1u0071\",\"s16d1fd758b58v1u0072\"]},{\"text\":\"팔다리 힘 빠짐이나 갑작스런 두통이 생기거나 심하게 토하기 시작하면 응급실로 가라고 안내함.\",\"utteranceIds\":[\"s16d1fd758b58v1u0077\",\"s16d1fd758b58v1u0079\"]},{\"text\":\"처방전을 약국으로 보내기로 했고, Lloyd 약국으로 보내는지 확인한 뒤 진행함.\",\"utteranceIds\":[\"s16d1fd758b58v1u0082\",\"s16d1fd758b58v1u0083\"]},{\"text\":\"며칠 안에 대면 진료를 받아 혈압과 보행을 확인하고 다음 계획을 정하기로 함.\",\"utteranceIds\":[\"s16d1fd758b58v1u0076\",\"s16d1fd758b58v1u0081\",\"s16d1fd758b58v1u0092\"]}],\"details\":{\"symptoms\":[{\"text\":\"메스꺼움이 있고 실제 구토는 없었음.\",\"utteranceIds\":[\"s16d1fd758b58v1u0018\",\"s16d1fd758b58v1u0061\"]},{\"text\":\"귀에서 약한 윙윙거림이 있으나 귀통증, 진물, 청력저하, 먹먹함은 없었음.\",\"utteranceIds\":[\"s16d1fd758b58v1u0021\",\"s16d1fd758b58v1u0043\",\"s16d1fd758b58v1u0044\",\"s16d1fd758b58v1u0056\",\"s16d1fd758b58v1u0057\",\"s16d1fd758b58v1u0058\"]},{\"text\":\"다리나 팔은 잘 움직이고, 팔다리 힘 빠짐은 부인함.\",\"utteranceIds\":[\"s16d1fd758b58v1u0051\",\"s16d1fd758b58v1u0052\",\"s16d1fd758b58v1u0053\"]},{\"text\":\"최근 바이러스성 질환이나 감기·기침은 없다고 함.\",\"utteranceIds\":[\"s16d1fd758b58v1u0038\",\"s16d1fd758b58v1u0040\",\"s16d1fd758b58v1u0041\",\"s16d1fd758b58v1u0042\"]}],\"tests\":[{\"text\":\"대면 진료에서 혈압과 걷는 모습을 확인하기로 함.\",\"utteranceIds\":[\"s16d1fd758b58v1u0076\",\"s16d1fd758b58v1u0081\"]}],\"medicationMentions\":[{\"text\":\"약 이름은 말해지지 않았고, 한 번에 1알씩 하루 3번, 약 10일분 처방 예정임.\",\"utteranceIds\":[\"s16d1fd758b58v1u0084\"]},{\"text\":\"약은 음식과 크게 상관없고, 아침에 바로 증상이 있으면 메스꺼워서 먹기 힘들 수 있으니 그냥 복용해도 된다고 안내함.\",\"utteranceIds\":[\"s16d1fd758b58v1u0088\",\"s16d1fd758b58v1u0089\"]}],\"precautions\":[{\"text\":\"진료를 기다리는 동안 팔다리 힘 빠짐이나 갑작스런 두통이 생기면 응급실로 가라고 함.\",\"utteranceIds\":[\"s16d1fd758b58v1u0077\",\"s16d1fd758b58v1u0079\"]},{\"text\":\"증상 중 하나가 생기거나 심하게 토하기 시작하면 응급실에 가야 한다고 함.\",\"utteranceIds\":[\"s16d1fd758b58v1u0079\"]}],\"followUps\":[{\"text\":\"며칠 안에 의사에게 진료를 받고 이후 계획을 정하기로 함.\",\"utteranceIds\":[\"s16d1fd758b58v1u0085\"]},{\"text\":\"지원팀에 전화해 예약하라고 안내함.\",\"utteranceIds\":[\"s16d1fd758b58v1u0092\"]}]},\"items\":[{\"itemKey\":\"med1\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":null,\"doseText\":\"한 번에 1알\",\"frequencyText\":\"하루 3번\",\"startsOn\":null,\"endsOn\":null,\"instructions\":\"약국으로 처방전 전송 예정. 음식과 크게 상관없고, 아침에 증상이 있으면 메스꺼워서 먹기 힘들 수 있으니 그냥 복용해도 됨.\",\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[\"MED_NAME_MISSING\"],\"isConditional\":false,\"utteranceIds\":[\"s16d1fd758b58v1u0082\",\"s16d1fd758b58v1u0084\",\"s16d1fd758b58v1u0088\",\"s16d1fd758b58v1u0089\"]},{\"itemKey\":\"task1\",\"itemType\":\"TASK\",\"payload\":{\"schemaVersion\":1,\"kind\":\"HOSPITAL\",\"title\":\"응급실 방문\",\"description\":\"진료를 기다리는 동안 팔다리에 힘이 빠지거나 갑자기 두통이 생기면, 또는 증상 중 하나가 생기거나 심하게 토하기 시작하면 응급실에 가야 함.\",\"date\":null,\"time\":null,\"durationMinutes\":null,\"durationSource\":null,\"recurrence\":null,\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[],\"isConditional\":true,\"utteranceIds\":[\"s16d1fd758b58v1u0077\",\"s16d1fd758b58v1u0079\"]},{\"itemKey\":\"task2\",\"itemType\":\"TASK\",\"payload\":{\"schemaVersion\":1,\"kind\":\"EXAM\",\"title\":\"대면 진료 및 혈압/보행 확인\",\"description\":\"며칠 안에 대면 진료를 받아 혈압과 걷는 모습을 확인하고 다음 계획을 정함.\",\"date\":null,\"time\":null,\"durationMinutes\":null,\"durationSource\":null,\"recurrence\":null,\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[],\"isConditional\":false,\"utteranceIds\":[\"s16d1fd758b58v1u0076\",\"s16d1fd758b58v1u0081\",\"s16d1fd758b58v1u0085\"]},{\"itemKey\":\"task3\",\"itemType\":\"TASK\",\"payload\":{\"schemaVersion\":1,\"kind\":\"OTHER\",\"title\":\"지원팀에 예약 전화\",\"description\":\"지원팀에 전화해서 예약하라고 안내함.\",\"date\":null,\"time\":null,\"durationMinutes\":null,\"durationSource\":null,\"recurrence\":null,\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[],\"isConditional\":false,\"utteranceIds\":[\"s16d1fd758b58v1u0092\"]}]}"
