      "annotations" : [ ],
      "logprobs" : [ ],
      "text" : "{\"schemaVersion\":\"1.0\",\"summary\":[{\"text\":\"지난 3일간 하루 5~6회의 묽은 물 같은 설사가 있었고, 처음의 구토는 멈춘 상태로 보임.\",\"utteranceIds\":[\"s71c55c29c708v1u0013\",\"s71c55c29c708v1u0015\",\"s71c55c29c708v1u0019\",\"s71c55c29c708v1u0021\",\"s71c55c29c708v1u0023\",\"s71c55c29c708v1u0035\"]},{\"text\":\"진료상 위장염(gastroenteritis) 가능성이 언급되었고, 보통 3~5일 지나면 좋아진다고 설명함.\",\"utteranceIds\":[\"s71c55c29c708v1u0082\"]},{\"text\":\"수분을 충분히 마시고, 열과 기운 없음이 있으면 Paracetamol을 복용할 수 있다고 안내함.\",\"utteranceIds\":[\"s71c55c29c708v1u0085\",\"s71c55c29c708v1u0087\",\"s71c55c29c708v1u0090\"]},{\"text\":\"나아질 때까지 1~2일 더 일을 쉬고, 설사가 멎은 뒤 24~48시간 후에 복귀하라고 했으며, 다음 주에도 낫지 않으면 다시 진료받으라고 함.\",\"utteranceIds\":[\"s71c55c29c708v1u0092\",\"s71c55c29c708v1u0093\",\"s71c55c29c708v1u0095\"]}],\"details\":{\"symptoms\":[{\"text\":\"설사가 심해 화장실을 매우 자주 가며, 탈수된 느낌과 식욕 저하, 기운 없음이 있음.\",\"utteranceIds\":[\"s71c55c29c708v1u0015\",\"s71c55c29c708v1u0028\",\"s71c55c29c708v1u0031\",\"s71c55c29c708v1u0033\",\"s71c55c29c708v1u0040\"]},{\"text\":\"처음에는 몇 번 토했으나 현재는 구토가 없고 설사만 지속됨.\",\"utteranceIds\":[\"s71c55c29c708v1u0019\",\"s71c55c29c708v1u0035\"]},{\"text\":\"변에 피는 없는 것으로 봄.\",\"utteranceIds\":[\"s71c55c29c708v1u0025\",\"s71c55c29c708v1u0026\"]},{\"text\":\"배아픔은 거의 없고, 두통이나 근육통도 별로 없음.\",\"utteranceIds\":[\"s71c55c29c708v1u0027\",\"s71c55c29c708v1u0028\",\"s71c55c29c708v1u0041\",\"s71c55c29c708v1u0042\"]},{\"text\":\"처음에는 약간 열이 나는 것 같았으나 지금은 괜찮고, 조금 뜨거운 느낌만 남아 있음.\",\"utteranceIds\":[\"s71c55c29c708v1u0037\",\"s71c55c29c708v1u0038\"]}],\"tests\":[],\"medicationMentions\":[{\"text\":\"천식 때문에 파란 흡입기를 드물게, 필요할 때만 사용함. 다른 약은 없음.\",\"utteranceIds\":[\"s71c55c29c708v1u0053\",\"s71c55c29c708v1u0056\",\"s71c55c29c708v1u0057\",\"s71c55c29c708v1u0058\"]},{\"text\":\"Dioralyte를 약국에서 구할 수 있는 수분 보충 음료로 안내함.\",\"utteranceIds\":[\"s71c55c29c708v1u0087\"]},{\"text\":\"열이 나고 기운이 없으면 Paracetamol을 복용해도 된다고 함.\",\"utteranceIds\":[\"s71c55c29c708v1u0090\"]}],\"precautions\":[{\"text\":\"물을 충분히 마시라고 안내함.\",\"utteranceIds\":[\"s71c55c29c708v1u0085\"]},{\"text\":\"필요하면 약국의 Dioralyte로 수분과 미네랄, 비타민 보충에 도움을 받을 수 있다고 설명함.\",\"utteranceIds\":[\"s71c55c29c708v1u0087\"]},{\"text\":\"열이 나고 기운이 없을 때는 Paracetamol을 복용할 수 있다고 안내함.\",\"utteranceIds\":[\"s71c55c29c708v1u0090\"]}],\"followUps\":[{\"text\":\"나아질 때까지 앞으로 1~2일 더 일을 쉬라고 권함.\",\"utteranceIds\":[\"s71c55c29c708v1u0092\"]},{\"text\":\"설사가 멎은 뒤 24~48시간이 지나야 일터로 돌아갈 수 있다고 안내함.\",\"utteranceIds\":[\"s71c55c29c708v1u0093\"]},{\"text\":\"앞으로 며칠 경과를 보고, 다음 주에도 낫지 않으면 다시 진료받으라고 함.\",\"utteranceIds\":[\"s71c55c29c708v1u0095\"]},{\"text\":\"안 나으면 다시 전화하겠다고 함.\",\"utteranceIds\":[\"s71c55c29c708v1u0099\"]}]},\"items\":[{\"itemKey\":\"med1\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"Dioralyte\",\"doseText\":null,\"frequencyText\":null,\"startsOn\":null,\"endsOn\":null,\"instructions\":\"약국에서 구할 수 있는 수분 보충 음료로, 잃은 미네랄과 비타민 보충에 도움이 된다고 안내함.\",\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[],\"isConditional\":false,\"utteranceIds\":[\"s71c55c29c708v1u0087\"]},{\"itemKey\":\"med2\",\"itemType\":\"MEDICATION\",\"payload\":{\"schemaVersion\":1,\"name\":\"Paracetamol\",\"doseText\":null,\"frequencyText\":null,\"startsOn\":null,\"endsOn\":null,\"instructions\":\"열이 나고 기운이 없으면 복용 가능.\",\"supersedesMedicationId\":null,\"schedulePlans\":[]},\"uncertaintyCodes\":[],\"isConditional\":true,\"utteranceIds\":[\"s71c55c29c708v1u0090\"]},{\"itemKey\":\"task1\",\"itemType\":\"TASK\",\"payload\":{\"schemaVersion\":1,\"kind\":\"OTHER\",\"title\":\"휴식\",\"description\":\"나아질 때까지 앞으로 1~2일 더 일을 쉬기\",\"date\":null,\"time\":null,\"durationMinutes\":null,\"durationSource\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[],\"isConditional\":false,\"utteranceIds\":[\"s71c55c29c708v1u0092\"]},{\"itemKey\":\"task2\",\"itemType\":\"TASK\",\"payload\":{\"schemaVersion\":1,\"kind\":\"OTHER\",\"title\":\"진료 재방문\",\"description\":\"앞으로 며칠 경과를 보고, 다음 주에도 낫지 않으면 다시 진료받기\",\"date\":null,\"time\":null,\"durationMinutes\":null,\"durationSource\":null,\"recurrence\":\"ONCE\",\"lastDate\":null,\"weekdays\":[]},\"uncertaintyCodes\":[],\"isConditional\":true,\"utteranceIds\":[\"s71c55c29c708v1u0095\"]}]}"
