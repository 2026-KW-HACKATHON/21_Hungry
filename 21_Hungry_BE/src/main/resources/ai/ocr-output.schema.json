{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowone.local/schemas/ocr-output-v1.0.json",
  "title": "Document OCR output v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pages"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "text"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" }
        }
      }
    }
  }
}
