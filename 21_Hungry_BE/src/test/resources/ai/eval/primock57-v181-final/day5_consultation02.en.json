                  },
                  {
                      "speaker":  "doctor",
                      "start":  416.406434728778,
                      "end":  424.447803141685,
                      "interval":  121,
                      "en":  "OK, that\u0027s fine. So the antibiotics, that I\u0027m gonna prescribe, um, will go through to that, pharmacy.",
                      "id":  "121"
