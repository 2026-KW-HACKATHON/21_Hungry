                  },
                  {
                      "speaker":  "doctor",
                      "start":  190.91303634661469,
                      "end":  200.127496786531,
                      "interval":  42,
                      "en":  "whether there\u0027s physical blockage or whether there\u0027s something else going on, OK? Um, can I just double check, the dizziness that you\u0027ve been getting, um, how severe is it?",
